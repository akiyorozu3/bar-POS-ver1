rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ログイン済みか
    function isAuthed() {
      return request.auth != null;
    }

    // オーナーか（ログインIDが owner のアカウント）
    // ※ VITE_OWNER_ID / VITE_AUTH_ID_DOMAIN を変えた場合はここも合わせること
    function isOwner() {
      return isAuthed() && request.auth.token.email == 'owner@bar-pos.local';
    }

    // マネージャーか（オーナーより弱く、スタッフより強い）
    // ※ VITE_MANAGER_ID を変えた場合はここも合わせること
    function isManager() {
      return isAuthed() && request.auth.token.email == 'manager@bar-pos.local';
    }

    // 税務か（閲覧のみ：売上管理・金庫・純利益を見られるが入力は一切不可）
    // ※ VITE_ZEIMU_ID を変えた場合はここも合わせること
    function isZeimu() {
      return isAuthed() && request.auth.token.email == 'zeimu@bar-pos.local';
    }

    // 売上管理を見られる権限（オーナー or マネージャー）＝追加/編集/削除まで可能
    function canSales() {
      return isOwner() || isManager();
    }

    // 売上・金庫・純利益を「閲覧」できる権限（オーナー・マネージャー・税務）
    function canViewFinance() {
      return canSales() || isZeimu();
    }

    // メニュー：ログイン済みは閲覧可 / 追加・編集・削除はオーナーのみ
    match /menus/{id} {
      allow read: if isAuthed();
      allow write: if isOwner();
    }

    // キャスト：ログイン済みは閲覧可（注文画面の担当選択に必要） / 編集はオーナーのみ
    match /casts/{id} {
      allow read: if isAuthed();
      allow write: if isOwner();
    }

    // 席・未会計の注文：ログイン済みなら読み書き可（スタッフが注文を取るため）
    match /tables/{id} {
      allow read, write: if isAuthed();
    }

    // レジ締め：ログイン済みは閲覧可（締め済み判定に必要） / 締め・解除はオーナーのみ
    match /closures/{id} {
      allow read: if isAuthed();
      allow write: if isOwner();
    }

    // 打刻：ログイン済みは閲覧・作成可（将来スタッフにも開放できるように） / 修正・削除はオーナーのみ
    match /punches/{id} {
      allow read, create: if isAuthed();
      allow update, delete: if isOwner();
    }

    // 日払い/大入：閲覧はオーナー・マネージャー・税務／追加・削除はオーナー・マネージャー
    match /payouts/{id} {
      allow read: if canViewFinance();
      allow write: if canSales();
    }

    // 経費・固定費：閲覧はオーナー・マネージャー・税務／追加・削除はオーナー・マネージャー
    match /expenses/{id} {
      allow read: if canViewFinance();
      allow write: if canSales();
    }
    match /recurringExpenses/{id} {
      allow read: if canViewFinance();
      allow write: if canSales();
    }

    // 予定シフト・シフト週：オーナー・マネージャーのみ（閲覧・編集）
    match /shifts/{id} {
      allow read, write: if canSales();
    }
    match /shiftWeeks/{id} {
      allow read, write: if canSales();
    }
    // シフト表専用のキャスト並び順（owner/manager が変更可。casts本体はオーナーのみなので別管理）
    match /shiftSettings/{id} {
      allow read, write: if canSales();
    }
    // 金庫（お金の残高台帳）：閲覧はオーナー・マネージャー・税務（残高/履歴照会）／入出金・期首残高はオーナー・マネージャー
    match /cashEntries/{id} {
      allow read: if canViewFinance();
      allow write: if canSales();
    }
    match /cashSettings/{id} {
      allow read: if canViewFinance();
      allow write: if canSales();
    }

    // 手数料設定：ログイン済みは閲覧可（会計計算に必要） / 変更はオーナーのみ
    match /settings/{id} {
      allow read: if isAuthed();
      allow write: if isOwner();
    }

    // 取引（売上）：スタッフは「会計の確定（作成）」のみ。
    // 閲覧はログイン済み全員（日報の売上自動入力のため。※UIのスタッフは売上管理画面には入れない）。
    // 修正・削除はオーナーのみ。
    match /transactions/{id} {
      allow create: if isAuthed();
      allow read: if isAuthed();
      allow update, delete: if isOwner();
    }

    // 日報：閲覧はログイン済み全員。作成は税務以外（owner/manager/staff）。削除はオーナー・マネージャー。
    match /dailyReports/{id} {
      allow read: if isAuthed();
      allow create: if isAuthed() && !isZeimu();
      allow update, delete: if canSales();
    }
  }
}
