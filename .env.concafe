# 新店（concafe）本番環境の設定。`vite --mode concafe` で読み込まれる。
# 対象プロジェクト: bar-pos-concafe（他店 bar-pos-b1993 / staging とは別・データ完全隔離）
# Firebaseのウェブ設定値はクライアントに公開される種類のもの（機密ではない）。
# 本番運用なので VITE_APP_ENV は設定しない（TESTバナーを出さない）。
VITE_FIREBASE_API_KEY=AIzaSyBqX9AejGI4wSG6xVL5w66_SsH7-yr9Uzs
VITE_FIREBASE_AUTH_DOMAIN=bar-pos-concafe.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bar-pos-concafe
VITE_FIREBASE_STORAGE_BUCKET=bar-pos-concafe.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=591544227003
VITE_FIREBASE_APP_ID=1:591544227003:web:be8467a2194ac03185059e

# バック率（0.30 = 30%）
VITE_BACK_RATE=0.30

# ログインID→メール変換の固定ドメイン（Firestoreルールの owner@<ドメイン> と一致させること）
VITE_AUTH_ID_DOMAIN=bar-pos.local
VITE_OWNER_ID=owner

# 店識別バンド（取り違え防止）。店名と帯色を画面上部に常時表示する。
VITE_STORE_NAME=concafe
VITE_STORE_COLOR=#c2567a
